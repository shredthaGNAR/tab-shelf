---
// A screenshot that follows the viewer's colour scheme: light and dark
// captures of the real extension UI, swapped with <picture>.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  width: number;
  class?: string;
  loading?: "eager" | "lazy";
}
const { light, dark, alt, width, class: cls, loading = "lazy" } = Astro.props;
const widths = [width, width * 2];
const l = await getImage({ src: light, widths, format: "webp" });
const d = await getImage({ src: dark, widths, format: "webp" });
const height = Math.round((light.height / light.width) * width);
const sizes = `(max-width: ${width + 32}px) calc(100vw - 32px), ${width}px`;
---
<picture class={cls}>
  <source media="(prefers-color-scheme: dark)" srcset={d.srcSet.attribute} sizes={sizes} type="image/webp" />
  <img src={l.src} srcset={l.srcSet.attribute} sizes={sizes} alt={alt} width={width} height={height} loading={loading} decoding="async" />
</picture>
